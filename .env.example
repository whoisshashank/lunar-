# Copy this file to .env.local and fill in your Cesium ion values.
# VITE_ variables are included in browser code. Use a public assets:read token,
# restrict it to your app's URL, and never put a private token here.
VITE_CESIUM_ION_ACCESS_TOKEN=

# Asset IDs are listed in your Cesium ion dashboard. The imagery and 3D Tiles
# assets are separate; an imagery asset is needed to texture the lunar globe.
VITE_MOON_TILES_ASSET_ID=2684829
VITE_MOON_IMAGERY_ASSET_ID=
